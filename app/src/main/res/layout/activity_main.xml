<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nav_divider" />

    <View
        android:id="@+id/nav_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        app:layout_constraintBottom_toTopOf="@id/custom_bottom_nav" />

    <!-- GARANTİ ÇÖZÜM: Özel Alt Menü -->
    <LinearLayout
        android:id="@+id/custom_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#161618"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Generate Tab -->
        <LinearLayout
            android:id="@+id/nav_btn_generate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_icon_generate"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_generate"
                app:tint="@color/primary_electric" />
            <TextView
                android:id="@+id/nav_text_generate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generate"
                android:textSize="12sp"
                android:textColor="@color/primary_electric"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Library Tab -->
        <LinearLayout
            android:id="@+id/nav_btn_library"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_icon_library"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_library"
                app:tint="@color/nav_unselected" />
            <TextView
                android:id="@+id/nav_text_library"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Library"
                android:textSize="12sp"
                android:textColor="@color/nav_unselected"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Discover Tab -->
        <LinearLayout
            android:id="@+id/nav_btn_discover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_icon_discover"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_discover"
                app:tint="@color/nav_unselected" />
            <TextView
                android:id="@+id/nav_text_discover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discover"
                android:textSize="12sp"
                android:textColor="@color/nav_unselected"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>